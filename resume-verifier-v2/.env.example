# Application
APP_NAME=resume-verifier
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-in-production-use-secrets-manager
API_KEY=your-api-key-shared-with-nodejs-backend

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/resume_verifier_v2
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_verifier_v2

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Gemini AI (get from Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model IDs (verify at aistudio.google.com/models)
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_FLASH_MODEL=gemini-2.5-flash

# GitHub
GITHUB_TOKEN=optional-github-pat-for-private-repos
MAX_REPO_SIZE_MB=500
DOWNLOAD_TIMEOUT_SECONDS=120

# Worker
CELERY_CONCURRENCY=4
ANALYSIS_TIMEOUT_SECONDS=600

# LLM Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2
