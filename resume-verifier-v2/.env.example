# Application
APP_NAME=resume-verifier
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-in-production-use-secrets-manager
API_KEY=your-api-key-shared-with-nodejs-backend

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/resume_verifier_v2
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_verifier_v2

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Hugging Face (get token from huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your-huggingface-token-here

# Hugging Face Model IDs (set to your uploaded model or any public HF model)
HUGGINGFACE_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
HUGGINGFACE_PRO_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Groq (fallback LLM — used when HuggingFace fails or is unconfigured)
# Get key from console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback GitHub repo URLs — comma-separated list used when no links are found in resume text.
# These are the last resort after regex parsing and GitHub profile API both fail.
FALLBACK_GITHUB_URLS=https://github.com/Navn2025/Recruit_AI,https://github.com/Navn2025/AutoBot,https://github.com/Navn2025/Ayurwell,https://github.com/Navn2025/meetFlow-server

# GitHub
GITHUB_TOKEN=optional-github-pat-for-private-repos
MAX_REPO_SIZE_MB=500
DOWNLOAD_TIMEOUT_SECONDS=120

# Worker
CELERY_CONCURRENCY=4
ANALYSIS_TIMEOUT_SECONDS=600

# LLM Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2
